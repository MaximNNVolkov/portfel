PORT=3001
# Пароль и имя пользователя базы. Пароль обязателен: docker compose не поднимет postgres,
# если POSTGRES_PASSWORD не задан. Сгенерировать: openssl rand -hex 24
POSTGRES_DB=portfel
POSTGRES_USER=portfel
POSTGRES_PASSWORD=
# Должен совпадать с POSTGRES_* выше. Внутри docker compose хост — postgres, не localhost.
# В production (NODE_ENV=production) backend не стартует без этой переменной.
DATABASE_URL=postgresql://portfel:postgres_password_here@localhost:5432/portfel
SESSION_TTL_DAYS=30
# Ключ шифрования токенов брокеров (§28). Обязателен в production — без него backend
# падает на старте. Сгенерировать: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Режим T-Invest API: sandbox (виртуальный счёт, не требует боевого токена — по умолчанию)
# или production (реальный брокерский счёт). Переключение не требует правок кода —
# см. server/brokers/tinkoff.ts.
TINKOFF_API_MODE=sandbox
# §19/§21/§32: периодичность фоновых задач планировщика (server/scheduler.ts) — снимок
# портфеля, синхронизация брокера, обновление цен MOEX. По умолчанию раз в сутки.
SCHEDULER_INTERVAL_SECONDS=86400

# §34: такт опроса очереди OCR тем же планировщиком. Отдельный цикл, потому что загруженный
# скриншот нельзя заставлять ждать суточного прогона фоновых задач.
OCR_POLL_SECONDS=2

# BUG-10: сколько минут документ может провисеть в processing (например, воркер упал между
# захватом задачи и её завершением), прежде чем планировщик пометит его failed. Отдельный,
# более редкий такт проверки — таймаут на порядки больше, чем OCR_POLL_SECONDS.
OCR_STALE_TIMEOUT_MINUTES=5
OCR_STALE_CHECK_SECONDS=60

# §28: домен, на который указывает A-запись сервера. Нужен docker-compose.yml (шаблон
# nginx.conf.template подставляет его через envsubst) и init-letsencrypt.sh — без него
# первичный выпуск сертификата Let's Encrypt не запустится.
DOMAIN=
# Email для регистрации в Let's Encrypt (уведомления об истечении сертификата), нужен
# только init-letsencrypt.sh.
EMAIL=
# §28: код приглашения для регистрации на публичном стенде — без него /api/auth/register
# открыт всем желающим. Если оставить пустым, регистрация не ограничена (для локальной
# разработки).
REGISTRATION_INVITE_CODE=
