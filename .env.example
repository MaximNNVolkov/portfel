PORT=3001
DATABASE_URL=postgresql://portfel:portfel@localhost:5432/portfel
SESSION_TTL_DAYS=30
# Ключ шифрования токенов брокеров (§28). Сгенерировать: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Режим T-Invest API: sandbox (виртуальный счёт, не требует боевого токена — по умолчанию)
# или production (реальный брокерский счёт). Переключение не требует правок кода —
# см. server/brokers/tinkoff.ts.
TINKOFF_API_MODE=sandbox
