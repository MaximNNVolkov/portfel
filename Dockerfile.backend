FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Ставится после npm ci: иначе npm пропустил бы devDependencies, а запуск идёт через tsx.
ENV NODE_ENV=production

COPY server ./server
COPY db ./db
COPY tessdata ./tessdata

RUN mkdir -p server/uploads

EXPOSE 3001

CMD ["npx", "tsx", "server/index.ts"]
